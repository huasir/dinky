# 复制为 deploy.env 后填写（不要把含密码的 deploy.env 提交进仓库）
#
#   cp script/ltsk/deploy.env.example script/ltsk/deploy.env

# 目标主机（SSH）
DEPLOY_HOST=10.0.0.x
DEPLOY_USER=dinky
DEPLOY_PORT=22
# 可选：SSH 私钥路径；不填则用 ssh agent / 默认密钥
# DEPLOY_SSH_KEY=/path/to/id_rsa

# 远端安装根目录（其下会放 releases/ 与 current 软链）
DEPLOY_ROOT=/opt/dinky

# 远端启动用的 Flink 小版本号，对应 auto.sh 第二个参数，如 1.20
FLINK_VERSION=1.20

# 健康检查（可选）。留空则只做进程/脚本启动，不做 HTTP 探测
# HEALTHCHECK_URL=http://10.0.0.x:8888/api/health
HEALTHCHECK_URL=
HEALTHCHECK_TIMEOUT_SEC=120

# 是否在部署前备份当前版本（true/false）
BACKUP_BEFORE_DEPLOY=true

# 保留历史 release 个数（含本次）
KEEP_RELEASES=5
